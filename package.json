{
  "name": "sap-cf-mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for SAP BTP Cloud Foundry - reads mta.yaml, handles XSUAA authentication, and calls SAP APIs",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspector": "tsx src/inspector.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "clean": "rimraf dist",
    "mcp:cli": "node scripts/mcp-cli.js",
    "mcp:parse": "node scripts/mcp-cli.js parse",
    "mcp:list": "node scripts/mcp-cli.js list",
    "mcp:server": "node scripts/mcp-cli.js server",
    "tools": "./scripts/sap-cf-tools.sh",
    "tools:menu": "./scripts/sap-cf-tools.sh menu"
  },
  "keywords": [
    "mcp",
    "sap",
    "cloud-foundry",
    "btp",
    "xsuaa",
    "mta"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@sap/xssec": "^3.6.1",
    "axios": "^1.7.7",
    "yaml": "^2.4.5",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}